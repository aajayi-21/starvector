# The rollover check, each hour on the hour (spec PL1 section 3). Most
# firings find nothing due and move nothing. A close that failed gets
# a new try at the next firing, thus a failure costs about an hour and
# not a day.
#
# Keep closes_at_utc in /etc/starvector/service.json on the hour: a
# different minute closes at the first firing after it, up to 59
# minutes late, while the server's countdown shows the exact time.
#
# 04:30 is the unattended-upgrade reboot and 05:00 is the backup timer.
# A firing near them moves nothing unless a close is due, thus keep the
# close hour clear of them.

[Unit]
Description=Starvector day rollover check, each hour

[Timer]
OnCalendar=*-*-* *:00:00 UTC
AccuracySec=1s
# A box that was down catches up at boot. This is safe because the
# rollover closes only a day that is due, and it reads the status
# before each step.
Persistent=true

[Install]
WantedBy=timers.target
