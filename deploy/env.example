# /etc/starvector/env  (root:root, chmod 600)
# The two secrets the server needs. Set a spend cap on the
# OpenRouter account so a leaked key is bounded.
OPENROUTER_API_KEY=replace-me

# The operator token (spec M1 section 4). It stands in front of
# the day commands and the console. The server refuses to start when
# the store holds player records or sign-up is open and this is not
# set, thus a deployment cannot get a quiet hole.
#
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STARVECTOR_OPERATOR_TOKEN=replace-me

# The password pepper (spec A2 section 5.2). The server mixes it into
# each password before the slow digest, thus a copy of the store or of
# its backup holds no digest that a person can attack offline. The
# server refuses to start when sign-up is open, or when the store holds
# credential records, and this is not set.
#
# KEEP A COPY AWAY FROM THIS BOX. If this value is gone or changes,
# each stored password stops working, and each player must use a
# recovery code.
#
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STARVECTOR_PASSWORD_PEPPER=replace-me

# Optional: a health check address the rollover pings after each run
# (spec BR1 section 3), with /fail added on a failure - for example a
# healthchecks.io check. The timer fires each hour (spec PL1 section
# 3), so give the check a 2-hour period: a silent box alerts you, and
# a failed close alerts you at each firing until it heals.
# STARVECTOR_HEALTHCHECK_URL=https://hc-ping.com/replace-me
