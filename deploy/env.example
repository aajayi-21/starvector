# /etc/starvector/env  (root:root, chmod 600)
# The two secrets the server needs. Set a spend cap on the
# OpenRouter account so a leaked key is bounded.
OPENROUTER_API_KEY=replace-me

# The operator token (spec M1 section 4). It stands in front of
# the day commands, the console, and the player mint. The server
# refuses to start when the store holds player records and this is
# not set, thus a deployment cannot get a quiet hole.
#
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STARVECTOR_OPERATOR_TOKEN=replace-me

# Optional: a health check address the daily rollover pings after
# each run (spec BR1 section 3), with /fail added on a failure - for
# example a healthchecks.io check with a 25-hour period, so a missed
# rollover alerts you.
# STARVECTOR_HEALTHCHECK_URL=https://hc-ping.com/replace-me
