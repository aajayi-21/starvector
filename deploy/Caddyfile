# Starvector edge (spec S2 section 4).
# Replace game.example.com with the real domain; Caddy fetches and
# renews the certificate on its own.

game.example.com {
	encode zstd gzip

	# The byte cap of a request body (spec PL1 section 1). The server
	# holds the same value in service/limits.py, thus a request that
	# skips the edge meets it too. The avatar cap in service/store.py
	# fits below it.
	request_body {
		max_size 1MiB
	}

	# The response headers (spec PL1 section 5). The built app holds
	# no inline script and no outside source, thus the policy names
	# this site alone. Inline style attributes are in the React code.
	# An image comes from this site, or a data or blob URL for a
	# picture the player is choosing. Referrer-Policy keeps an invite
	# URL out of each page the app links to.
	#
	# This Caddyfile holds no log directive, thus Caddy writes no
	# access log, and an invite URL does not reach one. Before adding
	# one, add a filter that drops the /join/ path: the token is a
	# credential. The server filters its own access log.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The operator plane and the console never serve publicly
	# (spec S2 ruling 2): the operator reaches them through an
	# SSH tunnel to the on-demand dev unit on 127.0.0.1:8001.
	#
	# Caddy path matching is exact unless a wildcard ends the
	# pattern, and /api/dev/* does NOT match the bare /api/dev -
	# which answers the day's target id. Both forms are listed.
	# /history is NOT here: the app owns that path.
	#
	# /dev and /ui/dev.js name nothing in the server since the
	# hand-written pages retired (2026-08-16). They stay refused
	# rather than falling to the app shell below, so a probe at a
	# console-shaped path meets a 404 and not a page.
	#
	# /api/players is the one operator path that is live in the
	# public process: the console surfaces need --dev, which this
	# process does not have, and the three day paths are below.
	# The mint needs neither, and the public process must hold the
	# operator token, because the server refuses to start with
	# player records stored and no token. That leaves the bearer
	# as its only layer where the rest have three. The console
	# reaches the mint through the tunnel to the dev unit and the
	# command-line path runs on the box, thus nothing wants it
	# here.
	# /api/ops is the operator's results reader (spec BR1 section 5):
	# bearer-gated in the process, and not public at the edge.
	@blocked path /dev.html /dev /ui/dev.js /api/dev /api/dev/* /api/day/open /api/day/close /api/day/reveal /api/players /api/ops /api/ops/*
	handle @blocked {
		respond 404
	}

	# The API and the images go to the one public uvicorn process.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /image/* {
		reverse_proxy 127.0.0.1:8000
	}

	# The invite gate (spec M1 section 4). This block must sit
	# above the catch-all: without it /join/{token} falls to the
	# SPA fallback below, serves the app shell, sets no cookie,
	# and every invited player lands on the invite gate telling
	# them to open the URL they just opened. No Python test can
	# see this - check it after each deploy:
	#   curl -sI https://game.example.com/join/bogus
	# must answer the server's 401 and not text/html.
	handle /join/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Hashed assets never fall back to index.html: a stale chunk
	# answers 404 cleanly instead of HTML.
	handle /assets/* {
		root * /srv/starvector/app/web/dist
		file_server
	}

	# The app shell with the SPA fallback. /history reaches the
	# app here, as the app's own screen.
	handle {
		root * /srv/starvector/app/web/dist
		try_files {path} /index.html
		file_server
	}
}
