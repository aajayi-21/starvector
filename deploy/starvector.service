# The one public uvicorn process (spec S2 section 4). Install:
#   cp deploy/starvector.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now starvector
#
# No --dev flag: the public process keeps the R3 gates on, thus
# /image serves revealed targets alone. The operator console runs
# against starvector-dev.service through the SSH tunnel.

[Unit]
Description=Starvector trial server
After=network-online.target
Wants=network-online.target

[Service]
User=starvector
Group=starvector
WorkingDirectory=/srv/starvector/app
# The env file holds OPENROUTER_API_KEY. systemd reads it as root
# before it drops privileges, thus root:root 0600 is right.
EnvironmentFile=/etc/starvector/env
# The venv interpreter directly: `uv run` would want a writable
# cache, which ProtectSystem=strict refuses.
ExecStart=/srv/starvector/app/.venv/bin/python -m service.server \
    --service-config /etc/starvector/service.json --port 8000
Restart=on-failure
RestartSec=2

# Hardening: the store and the data cache are the only writable
# paths, and they must exist before the unit starts.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/starvector/app/store /srv/starvector/app/data
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
